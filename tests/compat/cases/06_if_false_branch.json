{
  "id": "if_false_branch",
  "description": "IF routes false output to connected node",
  "category": "control-flow",
  "differential": false,
  "workflow": {
    "name": "IF False Branch",
    "active": false,
    "nodes": [
      {"name": "Start", "type": "n8n-nodes-base.manualTrigger", "position": [100, 100], "parameters": {}},
      {
        "name": "Check",
        "type": "n8n-nodes-base.if",
        "position": [300, 100],
        "parameters": {
          "conditions": {
            "options": {"combineOperation": "and"},
            "conditions": [
              {"leftValue": "={{ $json.score }}", "operator": "larger", "rightValue": 70}
            ]
          }
        }
      },
      {
        "name": "Fail",
        "type": "n8n-nodes-base.set",
        "position": [500, 180],
        "parameters": {
          "mode": "manual",
          "assignments": {"assignments": [{"name": "result", "value": "FAIL", "type": "string"}]}
        }
      }
    ],
    "connections": {
      "Start": {"main": [[{"node": "Check", "type": "main", "index": 0}]]},
      "Check": {"main": [[], [{"node": "Fail", "type": "main", "index": 0}]]}
    }
  },
  "input": [{"score": 50}],
  "expected": [{"score": 50, "result": "FAIL"}]
}
