{
  "id": "switch_fallback_first",
  "description": "Switch fallback routes unmatched items to output 0",
  "category": "control-flow",
  "workflow": {
    "name": "Switch Fallback",
    "active": false,
    "nodes": [
      {"name": "Start", "type": "n8n-nodes-base.manualTrigger", "position": [100, 100], "parameters": {}},
      {
        "name": "Route",
        "type": "n8n-nodes-base.switch",
        "position": [300, 100],
        "parameters": {
          "mode": "rules",
          "rules": {
            "values": [
              {
                "conditions": {
                  "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
                  "conditions": [
                    {
                      "leftValue": "={{ $json.type }}",
                      "operator": {"operation": "equals", "type": "string"},
                      "rightValue": "A"
                    }
                  ],
                  "combinator": "and"
                },
                "outputKey": "A"
              }
            ]
          },
          "options": {"fallbackOutput": 0}
        }
      },
      {
        "name": "Fallback",
        "type": "n8n-nodes-base.set",
        "position": [500, 100],
        "parameters": {
          "mode": "manual",
          "assignments": {"assignments": [{"name": "route", "value": "fallback", "type": "string"}]}
        }
      }
    ],
    "connections": {
      "Start": {"main": [[{"node": "Route", "type": "main", "index": 0}]]},
      "Route": {"main": [[{"node": "Fallback", "type": "main", "index": 0}]]}
    }
  },
  "input": [{"type": "Z"}],
  "expected": [{"type": "Z", "route": "fallback"}]
}
