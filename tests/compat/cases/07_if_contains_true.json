{
  "id": "if_contains_true",
  "description": "IF contains operator works for strings",
  "category": "control-flow",
  "workflow": {
    "name": "IF Contains",
    "active": false,
    "nodes": [
      {"name": "Start", "type": "n8n-nodes-base.manualTrigger", "position": [100, 100], "parameters": {}},
      {
        "name": "Check",
        "type": "n8n-nodes-base.if",
        "position": [300, 100],
        "parameters": {
          "conditions": {
            "options": {"combineOperation": "and"},
            "conditions": [
              {"leftValue": "={{ $json.message }}", "operator": "contains", "rightValue": "flow"}
            ]
          }
        }
      },
      {
        "name": "Mark",
        "type": "n8n-nodes-base.set",
        "position": [500, 100],
        "parameters": {
          "mode": "manual",
          "assignments": {"assignments": [{"name": "containsFlow", "value": true, "type": "boolean"}]}
        }
      }
    ],
    "connections": {
      "Start": {"main": [[{"node": "Check", "type": "main", "index": 0}]]},
      "Check": {"main": [[{"node": "Mark", "type": "main", "index": 0}], []]}
    }
  },
  "input": [{"message": "workflow-core"}],
  "expected": [{"message": "workflow-core", "containsFlow": true}]
}
