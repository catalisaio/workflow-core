{
  "id": "switch_rules_branch",
  "description": "Switch routes rules match to first output",
  "category": "control-flow",
  "workflow": {
    "name": "Switch Rules",
    "active": false,
    "nodes": [
      {
        "name": "Start",
        "type": "n8n-nodes-base.manualTrigger",
        "position": [100, 100],
        "parameters": {}
      },
      {
        "name": "Route",
        "type": "n8n-nodes-base.switch",
        "position": [300, 100],
        "parameters": {
          "mode": "rules",
          "rules": {
            "values": [
              {
                "conditions": {
                  "options": {
                    "caseSensitive": true,
                    "leftValue": "",
                    "typeValidation": "strict"
                  },
                  "conditions": [
                    {
                      "leftValue": "={{ $json.type }}",
                      "operator": {
                        "operation": "equals",
                        "type": "string"
                      },
                      "rightValue": "A"
                    }
                  ],
                  "combinator": "and"
                },
                "outputKey": "A"
              }
            ]
          },
          "options": {
            "fallbackOutput": "none"
          }
        }
      },
      {
        "name": "Set Route",
        "type": "n8n-nodes-base.set",
        "position": [500, 100],
        "parameters": {
          "mode": "manual",
          "assignments": {
            "assignments": [
              {
                "name": "route",
                "value": "A",
                "type": "string"
              }
            ]
          }
        }
      }
    ],
    "connections": {
      "Start": {
        "main": [
          [
            {
              "node": "Route",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Route": {
        "main": [
          [
            {
              "node": "Set Route",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    }
  },
  "input": [
    {
      "type": "A"
    }
  ],
  "expected": [
    {
      "type": "A",
      "route": "A"
    }
  ]
}
