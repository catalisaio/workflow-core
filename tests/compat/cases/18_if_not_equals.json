{
  "id": "if_not_equals",
  "description": "IF notEquals operator routes correctly",
  "category": "control-flow",
  "workflow": {
    "name": "IF Not Equals",
    "active": false,
    "nodes": [
      {"name": "Start", "type": "n8n-nodes-base.manualTrigger", "position": [100, 100], "parameters": {}},
      {
        "name": "Check",
        "type": "n8n-nodes-base.if",
        "position": [300, 100],
        "parameters": {
          "conditions": {
            "options": {"combineOperation": "and"},
            "conditions": [
              {"leftValue": "={{ $json.status }}", "operator": "notEquals", "rightValue": "ok"}
            ]
          }
        }
      },
      {
        "name": "Mark",
        "type": "n8n-nodes-base.set",
        "position": [500, 100],
        "parameters": {
          "mode": "manual",
          "assignments": {"assignments": [{"name": "needsReview", "value": true, "type": "boolean"}]}
        }
      }
    ],
    "connections": {
      "Start": {"main": [[{"node": "Check", "type": "main", "index": 0}]]},
      "Check": {"main": [[{"node": "Mark", "type": "main", "index": 0}], []]}
    }
  },
  "input": [{"status": "error"}],
  "expected": [{"status": "error", "needsReview": true}]
}
